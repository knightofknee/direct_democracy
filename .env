# Public client-side config (identifiers, not secrets - safe to commit).
# Loaded automatically by Expo into EXPO_PUBLIC_* at build time; EAS builds
# pick this file up too, so nothing needs to be set on eas.dev.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=376113063983-gq4p2op1mk3kh64hjv1heh35pirok0t6.apps.googleusercontent.com
# Where an emailed sign-in link lands if the app is NOT installed (must be an
# authorized domain in Firebase Auth settings).
EXPO_PUBLIC_AUTH_CONTINUE_URL=https://www.waldgrave.com/directdemocracy/auth
# App Check web attestation (reCAPTCHA v3 site key - public by design)
EXPO_PUBLIC_RECAPTCHA_V3_SITE_KEY=6LezBHQtAAAAAFOR58fU7UAw372JhBb1l3nBfe3v
