rules_version = '2';

// direct democracy security rules.
//
// Trust model: clients may only create/update documents that represent their
// own voice - their profile's display name, their ballot, their comment,
// their question, their judgment. Every aggregate number (tallies, board
// scores, comment counts, AMA counters, question statuses) is written
// exclusively by Cloud Functions triggers via the Admin SDK, which bypasses
// these rules. No client update path can touch a total.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOfficial() {
      return signedIn() && me().role == 'official';
    }

    function isCandidate() {
      return signedIn() && me().role == 'candidate';
    }

    // Politician accounts are provisioned as placeholders keyed to a public
    // email; every act-as-politician write requires a verified email so a
    // sign-in that never proved control of the inbox can do nothing. All
    // real claim paths (password reset, magic link, SSO) verify the email.
    function verifiedEmail() {
      return request.auth.token.email_verified == true;
    }

    // Platform operator - may review reports and remove reported content.
    // Tied to the operator's sign-in email for now; move to custom claims
    // when there's more than one admin.
    //
    // email_verified is REQUIRED: Firebase lets anyone self-register an
    // email/password account under any address without proving they own it,
    // so matching the address alone would hand the report queue and takedown
    // powers to whoever registers it first.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'bricarlis@gmail.com';
    }

    // Display names may not pose as an alderman: the app names officials
    // "Ald. ..." / "Alderman ...". Mirror of validateDisplayName (names.ts).
    // A name can't open with a space or an invisible character either (the
    // app trims names), so "\u200bAlderman ..." can't slip past the check.
    function notAldermanName(name) {
      return !name.lower().matches('^\\s*(ald\\.|ald\\s|alder(man|woman|person)).*')
        && !name.matches('^[\\s\\x{00A0}\\x{1680}\\x{180E}\\x{2000}-\\x{200F}\\x{2028}-\\x{202F}\\x{205F}-\\x{206F}\\x{3000}\\x{FEFF}].*');
    }

    // Source links on a post: at most 10, and a bounded total (join() also
    // fails on anything that isn't a string, so it doubles as a type check).
    // Per-element https validation lives in the client writer and every
    // renderer (see docs/AUDIT.md).
    function refsOk(d) {
      return !('references' in d)
        || (d.references is list
          && d.references.size() <= 10
          && d.references.join(' ').size() <= 5100);
    }

    // A comment's thread is the id of its root comment: a plain document id,
    // so the trigger can never be steered to another path with it.
    function threadOk(d) {
      return !('threadId' in d)
        || d.threadId == null
        || (d.threadId is string && d.threadId.matches('^[A-Za-z0-9]{1,40}$'));
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // A tally that hasn't counted anyone yet. Every field is pinned - a
    // client that could seed nonzero counts or maps would fabricate support
    // that the verified lens displays as real.
    function emptyTally(t) {
      return t.keys().hasOnly(['all', 'verified', 'totalAll', 'totalVerified'])
        && t.all is map
        && t.verified is map
        && t.totalAll == 0
        && t.totalVerified == 0
        && t.all.size() == 0
        && t.verified.size() == 0;
    }

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Profiles are private; public-facing fields are denormalized onto
      // content at write time.
      allow read: if signedIn() && request.auth.uid == uid;

      // Self-registration: always starts unverified, citizen, no ward, zero
      // stats. The key sets are pinned so a client can't smuggle extra fields
      // (e.g. a spoofed personaAccountId, which deleteAccount would later use
      // to release someone else's identity-dedup claim).
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'role', 'verified', 'wardId', 'stats', 'createdAt'])
        && request.resource.data.role == 'citizen'
        && request.resource.data.verified == false
        && request.resource.data.wardId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.displayName.size() <= 30
        && notAldermanName(request.resource.data.displayName)
        && request.resource.data.stats.keys().hasOnly(['concerns', 'comments', 'votes', 'judgments'])
        && request.resource.data.stats.concerns == 0
        && request.resource.data.stats.comments == 0
        && request.resource.data.stats.votes == 0
        && request.resource.data.stats.judgments == 0;

      // Users may edit their display name and their phone-notification
      // settings (which types reach the phone, and this phone's push token)
      // - nothing else. verified / wardId / role are written only by the
      // Admin SDK (Didit webhook and admin tooling). Account deletion goes
      // through the deleteAccount callable (Admin SDK), not a client delete.
      allow update: if signedIn()
        && request.auth.uid == uid
        && onlyChanges(['displayName', 'pushPrefs', 'pushTokens'])
        && (
          !('displayName' in request.resource.data.diff(resource.data).affectedKeys())
          || (
            request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 3
            && request.resource.data.displayName.size() <= 30
            && notAldermanName(request.resource.data.displayName)
          )
        )
        && (
          !('pushPrefs' in request.resource.data)
          || (
            request.resource.data.pushPrefs is map
            && request.resource.data.pushPrefs.keys().hasOnly(['deadline', 'answers', 'comments', 'replies', 'credits', 'questions'])
          )
        )
        && (
          !('pushTokens' in request.resource.data)
          || (request.resource.data.pushTokens is map && request.resource.data.pushTokens.size() <= 10)
        );

      // In-app notifications, written only by Cloud Functions triggers.
      // The owner reads them, flips the read flag, and may delete - never
      // create, so nobody can forge a notification into someone's inbox.
      match /notifications/{noteId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn()
          && request.auth.uid == uid
          && onlyChanges(['read'])
          && request.resource.data.read is bool;
      }

      // Recent post times per ward, the basis of the ward posting limits.
      // Written only by the post triggers (gateWardPost); the owner reads it
      // so the app can say when their next post there opens.
      match /wardPosts/{wardId} {
        allow read: if signedIn() && request.auth.uid == uid;
      }

      // Recent post times per rate-limit bucket (citywide concerns, election
      // questions, comments, reports, ward changes). Written only by the
      // triggers and declareWard; the owner reads it for the app's notices.
      match /rateLimits/{bucket} {
        allow read: if signedIn() && request.auth.uid == uid;
      }

      // Personal block list - hides the blocked user's content on this
      // account's devices. The displayName snapshot powers the management
      // list on the profile.
      match /blocks/{blockedUid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.auth.uid != blockedUid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 30;
      }
    }

    // ── Reports (content moderation) ─────────────────────────────────────
    // Write-only from regular clients; only the admin reads the queue and
    // moves a report through its lifecycle. Who reported what stays private.
    match /reports/{reportId} {
      // contentPath must have the shape its contentType claims - otherwise a
      // report could show one document's excerpt while pointing the admin's
      // takedown delete at a different (innocent) document.
      // Anchored so a 'concern' report can't point at a comment path buried
      // inside it, whatever matches() does with unanchored patterns.
      function pathMatchesType(path, type) {
        return (type == 'concern' && path.matches('^concerns/[^/]+$'))
          || (type == 'comment' && (
            path.matches('^concerns/[^/]+/comments/[^/]+$')
            || path.matches('^candidates/[^/]+/policies/[^/]+/comments/[^/]+$')
            || path.matches('^officials/[^/]+/questions/[^/]+/comments/[^/]+$')
          ))
          || (type == 'policy' && path.matches('^candidates/[^/]+/policies/[^/]+$'))
          || (type in ['question', 'response'] && path.matches('^officials/[^/]+/questions/[^/]+$'))
          || (type == 'electionQuestion' && path.matches('^electionQuestions/[^/]+$'));
      }
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'contentPath', 'contentType', 'reason', 'excerpt',
          'authorUid', 'note', 'status', 'createdAt'
        ])
        // What's wrong, in the reporter's words: the app requires it for
        // "Other" (binaries before 2026-09-30 send none, so it stays optional here).
        && (!('note' in request.resource.data)
          || (request.resource.data.note is string
            && request.resource.data.note.size() >= 5
            && request.resource.data.note.size() <= 500))
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.contentPath is string
        && request.resource.data.contentPath.size() <= 300
        && request.resource.data.contentType in ['concern', 'comment', 'question', 'response', 'policy', 'electionQuestion']
        && pathMatchesType(request.resource.data.contentPath, request.resource.data.contentType)
        && request.resource.data.reason in ['spam', 'harassment', 'misleading', 'childSafety', 'other']
        && request.resource.data.excerpt is string
        && request.resource.data.excerpt.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open';
      allow read: if isAdmin();
      allow update: if isAdmin()
        && onlyChanges(['status'])
        && request.resource.data.status in ['open', 'resolved', 'dismissed'];
    }

    // ── Concerns (the big board) ─────────────────────────────────────────
    match /concerns/{concernId} {
      allow read: if true;

      // New concerns start with zeroed aggregates. authorName must match the
      // author's actual display name - no speaking as someone else.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'scope', 'wardId', 'authorUid', 'authorName',
          'authorVerified', 'tallies', 'score', 'scoreVerified',
          'commentCount', 'createdAt', 'references'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == me().displayName
        && request.resource.data.authorVerified == me().verified
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000
        // Source links shown under the concern. Rules can't iterate list
        // elements, so per-element https validation lives in the client
        // writer AND every renderer (see docs/AUDIT.md).
        && request.resource.data.references is list
        && refsOk(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.commentCount == 0
        && request.resource.data.score == 0
        && request.resource.data.scoreVerified == 0
        && emptyTally(request.resource.data.tallies)
        && (
          (request.resource.data.scope == 'city' && request.resource.data.wardId == null)
          || (
            request.resource.data.scope == 'ward'
            // Anyone may post in any ward (2026-09-27); the posting limits
            // (3 a day at home, 1 a week elsewhere) are enforced by
            // onConcernCreated, which deletes a post over the limit. The
            // hidden test ward 51 takes only its own residents.
            && request.resource.data.wardId is int
            && (
              (request.resource.data.wardId >= 1 && request.resource.data.wardId <= 50)
              || request.resource.data.wardId == me().wardId
            )
          )
        );

      // No client updates: authors edit through the editPost callable, which
      // records every edit in the post's history (and the earlier text, once
      // anyone had replied), so the history can't be skipped. Tallies,
      // scores, and commentCount stay trigger-only.

      // The author may withdraw their concern (and the admin may take down
      // reported ones); onConcernDeleted cleans up the subcollections.
      allow delete: if (signedIn() && request.auth.uid == resource.data.authorUid) || isAdmin();

      match /votes/{voterUid} {
        allow read: if signedIn() && request.auth.uid == voterUid;
        // One ballot per person; the verified/ward snapshot must match the
        // voter's actual profile. The ward snapshot lets the trigger scope a
        // ward concern's verified slice to ward residents.
        allow create, update: if signedIn()
          && request.auth.uid == voterUid
          && request.resource.data.keys().hasOnly(['uid', 'value', 'verified', 'wardId', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.verified == me().verified
          && request.resource.data.wardId == me().wardId
          && request.resource.data.value in ['1', '2', '3', '4', '5'];
        // Retract entirely - the trigger removes the ballot from the tallies.
        allow delete: if signedIn() && request.auth.uid == voterUid;
      }

      match /comments/{commentId} {
        allow read: if true;
        // threadId/replyToName make a comment a threaded reply (null or
        // absent on top-level comments). Shape-only validation: a bogus
        // threadId just renders as an orphaned thread - it can't move any
        // count, so no exists() read is spent on it. The concern itself
        // must exist, so no comment (or comment stats) floats free of one.
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/concerns/$(concernId))
          && request.resource.data.keys().hasOnly([
            'authorUid', 'authorName', 'authorVerified', 'body', 'createdAt',
            'threadId', 'replyToName', 'replyToUid', 'references'
          ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName == me().displayName
          && request.resource.data.authorVerified == me().verified
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time
          && threadOk(request.resource.data)
          && (!('replyToUid' in request.resource.data) || request.resource.data.replyToUid == null || (request.resource.data.replyToUid is string && request.resource.data.replyToUid.size() <= 128))
          && (
            !('replyToName' in request.resource.data)
            || request.resource.data.replyToName == null
            || (request.resource.data.replyToName is string && request.resource.data.replyToName.size() <= 80)
          )
          // Source links behind the comment's sources button. Per-element
          // https validation is client + render side (see docs/AUDIT.md).
          && refsOk(request.resource.data);
        // Authors may remove their own comments (admin: takedowns);
        // onCommentDeleted keeps the count honest.
        allow delete: if (signedIn() && request.auth.uid == resource.data.authorUid) || isAdmin();

        // Comment ratings: one up/down per person, placement-only (scores are
        // never displayed). The comment's score fields are trigger-only.
        match /votes/{voterUid} {
          allow read: if signedIn() && request.auth.uid == voterUid;
          allow create, update: if signedIn()
            && request.auth.uid == voterUid
            && request.resource.data.keys().hasOnly(['uid', 'value', 'verified', 'createdAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.verified == me().verified
            && request.resource.data.value in ['up', 'down'];
          allow delete: if signedIn() && request.auth.uid == voterUid;
        }
      }
    }

    // ── Polls (questions from elected officials and candidates) ──────────
    match /polls/{pollId} {
      allow read: if true;

      allow create: if (isOfficial() || isCandidate())
        && verifiedEmail()
        && request.resource.data.keys().hasOnly([
          'question', 'detail', 'type', 'options', 'scope', 'wardId',
          'authorUid', 'authorName', 'open', 'tallies', 'createdAt'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == me().displayName
        && request.resource.data.open == true
        && emptyTally(request.resource.data.tallies)
        && request.resource.data.question is string
        && request.resource.data.question.size() >= 10
        && request.resource.data.question.size() <= 280
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 4000
        && request.resource.data.type in ['yesNo', 'multipleChoice', 'approval', 'scale5']
        // `options` must be an actual list: a bare string would pass a size()
        // check and then crash every feed that maps over it.
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 12
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.scope == 'city' && request.resource.data.wardId == null)
          || (
            request.resource.data.scope == 'ward'
            && request.resource.data.wardId != null
            && request.resource.data.wardId == me().wardId
          )
        );

      // The author may close their poll, never reopen it: a closed poll's
      // result is a public record. Tallies are trigger-only.
      allow update: if signedIn()
        && request.auth.uid == resource.data.authorUid
        && onlyChanges(['open'])
        && request.resource.data.open == false;

      match /votes/{voterUid} {
        allow read: if signedIn() && request.auth.uid == voterUid;
        // The ballot's value must be one option key (or, for approval polls,
        // a short list of keys - the trigger dedupes and drops unknown keys,
        // so a stuffed or bogus ballot can never move a count by more than
        // one per option).
        allow create, update: if signedIn()
          && request.auth.uid == voterUid
          && request.resource.data.keys().hasOnly(['uid', 'value', 'verified', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.verified == me().verified
          && (
            request.resource.data.value is string
            || (
              request.resource.data.value is list
              && request.resource.data.value.size() >= 1
              && request.resource.data.value.size() <= 12
            )
          )
          && get(/databases/$(database)/documents/polls/$(pollId)).data.open == true
          && (
            get(/databases/$(database)/documents/polls/$(pollId)).data.scope == 'city'
            // Ward polls: residents of the ward, verified or declared. The
            // verified snapshot above decides which tally slice they land in.
            || me().wardId == get(/databases/$(database)/documents/polls/$(pollId)).data.wardId
          );
        // Retract entirely (the trigger removes the ballot from the tallies)
        // - but only while voting is open. A closed poll's result is a public
        // record; post-close retractions would quietly rewrite it.
        allow delete: if signedIn()
          && request.auth.uid == voterUid
          && get(/databases/$(database)/documents/polls/$(pollId)).data.open == true;
      }
    }

    // ── Election AMA (one question, every candidate) ─────────────────────
    // Anyone signed in proposes a question; any candidate answers, ONE
    // answer each - the answer doc id is the candidate's uid, and create is
    // pinned to it. answerCount and the answers' hidden placement scores are
    // trigger-only.
    match /electionQuestions/{questionId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'authorUid', 'authorName', 'authorVerified', 'body', 'answerCount',
          'upvotes', 'upvotesVerified', 'createdAt'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == me().displayName
        && request.resource.data.authorVerified == me().verified
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 1000
        && request.resource.data.answerCount == 0
        // get() with a default: binaries shipped before question upvotes
        // existed omit the fields, and that must stay a legal ask.
        && request.resource.data.get('upvotes', 0) == 0
        && request.resource.data.get('upvotesVerified', 0) == 0
        && request.resource.data.createdAt == request.time;

      // Question upvotes: "I want this answered too". Presence is the whole
      // ballot, one per person, retractable; the counts order the AMA list.
      match /votes/{voterUid} {
        allow read: if signedIn() && request.auth.uid == voterUid;
        allow create: if signedIn()
          && request.auth.uid == voterUid
          && get(/databases/$(database)/documents/electionQuestions/$(questionId)).data.authorUid != request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'verified', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.verified == me().verified
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == voterUid;
      }

      // The asker may withdraw only while unanswered - an answered question
      // is part of the candidates' public record. Admin: takedowns.
      allow delete: if (
          signedIn()
          && request.auth.uid == resource.data.authorUid
          && resource.data.answerCount == 0
        ) || isAdmin();

      match /answers/{candidateUid} {
        allow read: if true;

        // Timestamps are pinned: a forged createdAt would game the ranking
        // tie-break, and an omitted one would hide the answer from the
        // createdAt-ordered query while still counting it. The parent
        // question must exist so no orphan answers accumulate.
        allow create: if isCandidate()
          && verifiedEmail()
          && request.auth.uid == candidateUid
          && exists(/databases/$(database)/documents/electionQuestions/$(questionId))
          && request.resource.data.keys().hasOnly([
            'candidateUid', 'candidateName', 'body', 'score', 'scoreVerified',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.candidateUid == request.auth.uid
          && request.resource.data.candidateName == me().displayName
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 4000
          && request.resource.data.score == 0
          && request.resource.data.scoreVerified == 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Revisions touch the text (and the name snapshot, which must still
        // match the live profile); scores and createdAt stay frozen.
        allow update: if isCandidate()
          && verifiedEmail()
          && request.auth.uid == candidateUid
          && onlyChanges(['body', 'candidateName', 'updatedAt'])
          && request.resource.data.candidateName == me().displayName
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 4000
          && request.resource.data.updatedAt == request.time;

        // An answer is part of the public record the moment it posts:
        // letting the candidate delete would launder away downvotes (delete
        // cascades the ratings, re-posting starts at score 0). Revise the
        // text instead; takedowns are the admin's.
        allow delete: if isAdmin();

        // Answer ratings: one up/down per person, placement-only (scores are
        // never displayed). Same shape as comment ratings.
        match /votes/{voterUid} {
          allow read: if signedIn() && request.auth.uid == voterUid;
          allow create, update: if signedIn()
            && request.auth.uid == voterUid
            && request.resource.data.keys().hasOnly(['uid', 'value', 'verified', 'createdAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.verified == me().verified
            && request.resource.data.value in ['up', 'down'];
          allow delete: if signedIn() && request.auth.uid == voterUid;
        }
      }
    }

    // ── Officials & AMAs ─────────────────────────────────────────────────
    match /officials/{officialUid} {
      allow read: if true;

      // Officials edit their own bio, portrait link, and question-alert
      // threshold. The portrait is an externally hosted https URL - we never
      // take custody of the image. Name/title are provisioned by admins; all
      // counters are trigger-only.
      allow update: if signedIn()
        && request.auth.uid == officialUid
        && verifiedEmail()
        && onlyChanges(['bio', 'photoUrl', 'upvoteAlertThreshold'])
        && (
          !('photoUrl' in request.resource.data)
          || request.resource.data.photoUrl == null
          || (
            request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.matches('https://.*')
            && request.resource.data.photoUrl.size() <= 500
          )
        )
        && (
          !('bio' in request.resource.data)
          || (request.resource.data.bio is string && request.resource.data.bio.size() <= 1000)
        )
        && (
          !('upvoteAlertThreshold' in request.resource.data)
          || (
            request.resource.data.upvoteAlertThreshold is int
            && request.resource.data.upvoteAlertThreshold >= 1
            && request.resource.data.upvoteAlertThreshold <= 10000
          )
        );

      // Approval ballots - one standing approve/disapprove per person,
      // changeable or retractable any time. Aggregated by onApprovalWrite.
      // Anyone with a home ward (verified or declared once, 2026-09-24) may
      // rate; the GRADE counts only verified constituents (onApprovalWrite),
      // so declared-ward ballots show in the all-users count and never move
      // a report card.
      match /approvals/{voterUid} {
        allow read: if signedIn() && request.auth.uid == voterUid;
        allow create, update: if signedIn()
          && request.auth.uid == voterUid
          && request.auth.uid != officialUid
          && me().wardId != null
          && request.resource.data.keys().hasOnly(['value', 'verified', 'wardId', 'createdAt'])
          && request.resource.data.value in ['approve', 'disapprove']
          && request.resource.data.verified == me().verified
          && request.resource.data.wardId == me().wardId;
        allow delete: if signedIn() && request.auth.uid == voterUid;
      }

      match /questions/{questionId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'officialUid', 'authorUid', 'authorName', 'authorVerified', 'body',
            'status', 'response', 'respondedAt', 'answeredYes', 'answeredNo',
            'answeredYesVerified', 'answeredNoVerified', 'upvotes',
            'upvotesVerified', 'createdAt'
          ])
          // get() with a default: binaries shipped before question upvotes
          // existed omit the fields, and that must stay a legal ask.
          && request.resource.data.get('upvotes', 0) == 0
          && request.resource.data.get('upvotesVerified', 0) == 0
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName == me().displayName
          && request.resource.data.authorVerified == me().verified
          && request.resource.data.officialUid == officialUid
          // Only a real official's AMA takes questions: a made-up officialUid
          // would otherwise notify whoever holds that uid.
          && exists(/databases/$(database)/documents/officials/$(officialUid))
          && request.resource.data.status == 'awaitingResponse'
          && request.resource.data.response == null
          && request.resource.data.get('respondedAt', null) == null
          && request.resource.data.answeredYes == 0
          && request.resource.data.answeredNo == 0
          && request.resource.data.answeredYesVerified == 0
          && request.resource.data.answeredNoVerified == 0
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 10
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time;

        // The asker may withdraw a question only while it's unanswered -
        // once there's a response it is part of the official's public
        // record and stays (deleting a dodge would launder the score). The
        // admin may take down abusive threads at any stage; the
        // onQuestionDeleted trigger rebalances every counter.
        allow delete: if (
            signedIn()
            && request.auth.uid == resource.data.authorUid
            && resource.data.status == 'awaitingResponse'
          ) || isAdmin();

        // The only client update: the official posting their one response.
        // Judgment counts and status flips are written by onJudgmentWrite.
        allow update: if signedIn()
          && request.auth.uid == officialUid
          && verifiedEmail()
          && resource.data.response == null
          && onlyChanges(['response', 'respondedAt', 'status'])
          && request.resource.data.response is string
          && request.resource.data.response.size() >= 1
          && request.resource.data.response.size() <= 5000
          && request.resource.data.respondedAt == request.time
          && request.resource.data.status == 'underReview';

        match /judgments/{judgeUid} {
          allow read: if signedIn() && request.auth.uid == judgeUid;
          // Judgments only make sense once there's a response to judge. The
          // verified snapshot must match the judge's profile - it drives the
          // verified slice of the yes/no counts.
          allow create, update: if signedIn()
            && request.auth.uid == judgeUid
            && request.auth.uid != officialUid
            && request.resource.data.keys().hasOnly(['answered', 'verified', 'uid', 'wardId', 'createdAt'])
            && request.resource.data.answered is bool
            && request.resource.data.verified == me().verified
            // Optional: binaries before 2026-09-29 omit them.
            && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
            && request.resource.data.get('wardId', me().wardId) == me().wardId
            && get(/databases/$(database)/documents/officials/$(officialUid)/questions/$(questionId)).data.response != null;
          allow delete: if signedIn() && request.auth.uid == judgeUid;
        }

        // The conversation under an answered question (2026-09-29): same
        // threaded shape as board comments, open to everyone once the
        // official has responded. The official posts here as themselves,
        // so their writes need the confirmed email like every other
        // act-as-politician write.
        match /comments/{commentId} {
          allow read: if true;
          allow create: if signedIn()
            && get(/databases/$(database)/documents/officials/$(officialUid)/questions/$(questionId)).data.response != null
            && (request.auth.uid != officialUid || verifiedEmail())
            && request.resource.data.keys().hasOnly([
              'authorUid', 'authorName', 'authorVerified', 'body', 'createdAt',
              'threadId', 'replyToName', 'replyToUid', 'references'
            ])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorName == me().displayName
            && request.resource.data.authorVerified == me().verified
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 1
            && request.resource.data.body.size() <= 2000
            && request.resource.data.createdAt == request.time
            && threadOk(request.resource.data)
            && (!('replyToUid' in request.resource.data) || request.resource.data.replyToUid == null || (request.resource.data.replyToUid is string && request.resource.data.replyToUid.size() <= 128))
            && (
              !('replyToName' in request.resource.data)
              || request.resource.data.replyToName == null
              || (request.resource.data.replyToName is string && request.resource.data.replyToName.size() <= 80)
            )
            && refsOk(request.resource.data);
          allow delete: if (signedIn() && request.auth.uid == resource.data.authorUid) || isAdmin();

          match /votes/{voterUid} {
            allow read: if signedIn() && request.auth.uid == voterUid;
            allow create, update: if signedIn()
              && request.auth.uid == voterUid
              && request.resource.data.keys().hasOnly(['uid', 'value', 'verified', 'createdAt'])
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.verified == me().verified
              && request.resource.data.value in ['up', 'down'];
            allow delete: if signedIn() && request.auth.uid == voterUid;
          }
        }

        // Question upvotes: "I want this answered too". Presence is the
        // whole ballot (no value field), one per person, retractable. The
        // verified snapshot drives the weight in the official's answer
        // grade, so it must match the voter's live profile. The official
        // cannot join questions put to themselves.
        match /votes/{voterUid} {
          allow read: if signedIn() && request.auth.uid == voterUid;
          // wardId (optional: binaries before 2026-09-28 omit it) is pinned to
          // the voter's ward; with `verified` it decides whether this voter is
          // a proven resident, whose upvote weighs in the grade. The
          // question must exist: a vote under a made-up path would still
          // make the trigger recount the official's card.
          allow create: if signedIn()
            && request.auth.uid == voterUid
            && request.auth.uid != officialUid
            // The asker's own question already carries their weight; joining
            // it would count them twice. get() fails on a missing question.
            && get(/databases/$(database)/documents/officials/$(officialUid)/questions/$(questionId)).data.authorUid != request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'verified', 'wardId', 'createdAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.verified == me().verified
            && request.resource.data.get('wardId', me().wardId) == me().wardId
            && request.resource.data.createdAt == request.time;
          allow delete: if signedIn() && request.auth.uid == voterUid;
        }
      }
    }

    // ── Moderation ───────────────────────────────────────────────────────
    // moderation/shadowbanned: accounts hidden pending review (5+ reporters,
    // onReportCreated). Readable so every app can hide their posts, written
    // only by the server and the operator's moderation script.
    match /moderation/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── App config ───────────────────────────────────────────────────────
    // App-level config, not user data. config/app.latestVersion drives the
    // update nudge (src/lib/app-update.ts) and is compared against the
    // running binary's own version, so it must be readable BEFORE sign-in
    // (the check runs at cold start). World-readable is fine: it holds only
    // the released version string and public store links. Writes happen
    // exclusively via admin tooling (scripts/set-latest-version.ts), never
    // from clients.
    match /config/app {
      allow read: if true;
      allow write: if false;
    }

    // ── School board voter directory ─────────────────────────────────────
    // Read-only nominee cards for the 2026 school board election, seeded by
    // the operator (scripts/seed-school-board.ts) from public sources. Not
    // accounts; nothing on them is client-writable.
    match /schoolBoardCandidates/{nomineeId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Election voter directory ─────────────────────────────────────────
    // Same contract for every other upcoming race (November 2026 statewide
    // and county, February 2027 municipal): read-only cards and race notes
    // seeded by scripts/seed-election.ts from public sources.
    match /electionCandidates/{cardId} {
      allow read: if true;
      allow write: if false;
    }
    match /electionRaceNotes/{noteId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Candidates & the more perfect platform ───────────────────────────
    // Candidate records are operator-provisioned (Admin SDK), like officials.
    // A candidate's platform is a list of policies; each policy carries a
    // support/oppose dual tally, a votes subcollection, and a full comments
    // section. Synced policies (source 'site') are written only by the
    // platform-sync Cloud Function so the campaign site stays the single
    // source of truth; only in-app policies (source 'app') are client-editable.
    match /candidates/{candidateUid} {
      allow read: if true;

      // Candidates edit their own card: bio, portrait link, website link.
      // Name/office/sourceUrl are provisioned; counters are trigger-only.
      allow update: if signedIn()
        && request.auth.uid == candidateUid
        && verifiedEmail()
        && onlyChanges(['bio', 'photoUrl', 'websiteUrl'])
        && (
          !('bio' in request.resource.data)
          || (request.resource.data.bio is string && request.resource.data.bio.size() <= 1000)
        )
        && (
          !('photoUrl' in request.resource.data)
          || request.resource.data.photoUrl == null
          || (
            request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.matches('https://.*')
            && request.resource.data.photoUrl.size() <= 500
          )
        )
        && (
          !('websiteUrl' in request.resource.data)
          || request.resource.data.websiteUrl == null
          || (
            request.resource.data.websiteUrl is string
            && request.resource.data.websiteUrl.matches('https://.*')
            && request.resource.data.websiteUrl.size() <= 500
          )
        );

      match /policies/{policyId} {
        allow read: if true;

        // Candidates add in-app policies to their own platform, starting with
        // zeroed aggregates. Synced policies never enter through this door -
        // source is pinned to 'app'.
        allow create: if isCandidate()
          && request.auth.uid == candidateUid
          && verifiedEmail()
          && request.resource.data.keys().hasOnly([
            'candidateUid', 'section', 'title', 'body', 'links', 'order',
            'source', 'archived', 'tallies', 'commentCount', 'createdAt',
            'updatedAt'
          ])
          && request.resource.data.candidateUid == candidateUid
          && request.resource.data.source == 'app'
          && request.resource.data.archived == false
          && emptyTally(request.resource.data.tallies)
          && request.resource.data.commentCount == 0
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 140
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 20000
          && request.resource.data.section is string
          && request.resource.data.section.size() <= 60
          && request.resource.data.links is list
          && request.resource.data.links.size() <= 20
          && request.resource.data.order is number
          && request.resource.data.createdAt == request.time;

        // Candidates edit their own policies. Editing a synced policy takes
        // it over: source may change, but only to 'app', which also stops the
        // sync function from touching the doc again (it skips in-app ids).
        // Tallies and commentCount stay trigger-only.
        allow update: if signedIn()
          && request.auth.uid == candidateUid
          && verifiedEmail()
          && request.resource.data.source == 'app'
          && onlyChanges(['section', 'title', 'body', 'links', 'order', 'archived', 'updatedAt', 'source'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 140
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 20000
          && request.resource.data.section is string
          && request.resource.data.section.size() <= 60
          && request.resource.data.links is list
          && request.resource.data.links.size() <= 20
          && request.resource.data.order is number
          && request.resource.data.archived is bool;

        // Candidates may withdraw their in-app policies (admin: takedowns);
        // the onPolicyWrite trigger cascades to votes and comments.
        allow delete: if (
            signedIn()
            && request.auth.uid == candidateUid
            && verifiedEmail()
            && resource.data.source == 'app'
          ) || isAdmin();

        match /votes/{voterUid} {
          allow read: if signedIn() && request.auth.uid == voterUid;
          // One stance per person; the verified/ward snapshot must match the
          // voter's actual profile (candidate platforms are citywide, so the
          // verified slice counts every verified Chicagoan).
          // No stance votes on policies (arguments, not approval ratings): no
          // app reaches this path, so nothing new is written here. Old
          // ballots can still be retracted.
          allow create, update: if false;
          // Retract entirely - the trigger removes the ballot from the tallies.
          allow delete: if signedIn() && request.auth.uid == voterUid;
        }

        match /comments/{commentId} {
          allow read: if true;
          // Same threaded-reply shape as concern comments (see above), on a
          // policy that exists.
          allow create: if signedIn()
            && exists(/databases/$(database)/documents/candidates/$(candidateUid)/policies/$(policyId))
            && request.resource.data.keys().hasOnly([
              'authorUid', 'authorName', 'authorVerified', 'body', 'createdAt',
              'threadId', 'replyToName', 'replyToUid', 'references'
            ])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorName == me().displayName
            && request.resource.data.authorVerified == me().verified
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 1
            && request.resource.data.body.size() <= 2000
            && request.resource.data.createdAt == request.time
            && threadOk(request.resource.data)
            && (!('replyToUid' in request.resource.data) || request.resource.data.replyToUid == null || (request.resource.data.replyToUid is string && request.resource.data.replyToUid.size() <= 128))
            && (
              !('replyToName' in request.resource.data)
              || request.resource.data.replyToName == null
              || (request.resource.data.replyToName is string && request.resource.data.replyToName.size() <= 80)
            )
            // Source links behind the comment's sources button - same accepted
            // limitation as concern references (docs/AUDIT.md).
            && refsOk(request.resource.data);
          // Writing credit: the candidate marks a comment as one that changed
          // their policy - recognition only, retractable, never self-awarded.
          // The author's lifetime credit count is trigger-only.
          allow update: if signedIn()
            && request.auth.uid == candidateUid
            && isCandidate()
            && verifiedEmail()
            && exists(/databases/$(database)/documents/candidates/$(candidateUid)/policies/$(policyId))
            && resource.data.authorUid != candidateUid
            && onlyChanges(['credited', 'creditedAt'])
            && request.resource.data.credited is bool
            && request.resource.data.creditedAt == request.time;

          // Authors may remove their own comments (admin: takedowns);
          // onPolicyCommentDeleted keeps the count honest.
          allow delete: if (signedIn() && request.auth.uid == resource.data.authorUid) || isAdmin();

          // Comment ratings, same shape as concern comment votes above.
          match /votes/{voterUid} {
            allow read: if signedIn() && request.auth.uid == voterUid;
            allow create, update: if signedIn()
              && request.auth.uid == voterUid
              && request.resource.data.keys().hasOnly(['uid', 'value', 'verified', 'createdAt'])
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.verified == me().verified
              && request.resource.data.value in ['up', 'down'];
            allow delete: if signedIn() && request.auth.uid == voterUid;
          }
        }
      }
    }

    // ── Collection-group reads ───────────────────────────────────────────
    // AMA questions are public (matching the per-official rule above); the
    // group scope lets "my activity" query one user's questions across all
    // officials.
    // City Council, synced from the Clerk's public legislation API by the
    // syncCouncil function: public record, read by anyone, written by nobody
    // but the Admin SDK.
    match /council/{docId} {
      allow read: if true;
    }
    match /rollCalls/{rollCallId} {
      allow read: if true;
    }

    match /{path=**}/questions/{questionId} {
      allow read: if true;
    }

    // The command center reads an official's own comments across concerns
    // and a candidate's own answers across election questions. Both are
    // already public where they live; these open only the group queries.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }
    match /{path=**}/answers/{answerId} {
      allow read: if true;
    }
  }
}
