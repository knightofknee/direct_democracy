{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8085"
      ],
      "port": 8085
    },
    {
      "name": "expo-native",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "expo-web-emulators",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_USE_EMULATORS=1",
        "npx",
        "expo",
        "start",
        "--web",
        "--port",
        "8086"
      ],
      "port": 8086
    }
  ]
}
